#!/bin/bash
set -euo pipefail

# Prepare a version-bump PR; tag only after its merged main commit is verified.
if [[ "$(git branch --show-current)" == "main" ]]; then
  echo "Create a release branch before running ./version." >&2
  exit 1
fi
if [[ -n "$(git status --porcelain)" ]]; then
  echo "Commit or stash changes before preparing a release." >&2
  exit 1
fi

# Get the version line from pubspec.yaml
version_line=$(grep -E "^version:" pubspec.yaml)

# Extract current version (e.g., 1.2.3+4)
current_version=${version_line#version: }
IFS='.' read -r major minor patch_plus <<< "${current_version}"
IFS='+' read -r patch build <<< "${patch_plus}"

# Determine which part to roll (patch is default)
roll_type=${1:-patch}

case "$roll_type" in
  major)
    major=$((major + 1))
    minor=0
    patch=0
    ;;
  minor)
    minor=$((minor + 1))
    patch=0
    ;;
  patch)
    patch=$((patch + 1))
    ;;
  *)
    echo "Invalid argument: Use [major|minor|patch]"
    exit 1
    ;;
esac

# Always increment the build number
build=$((build + 1))

# New version string
new_version="${major}.${minor}.${patch}+${build}"

# Refresh the committed fallback used when Codex runtime metadata is absent.
if ! dart run tool/embed_codex_client_version.dart; then
  echo "Unable to refresh the embedded Codex client version"
  exit 1
fi

# Update pubspec.yaml (compatible with both Linux and macOS)
if [[ "$OSTYPE" == "darwin"* ]]; then
  sed -i "" "s/^version: .*/version: ${new_version}/" pubspec.yaml
else
  sed -i "s/^version: .*/version: ${new_version}/" pubspec.yaml
fi

# Commit changes
git add pubspec.yaml lib/chat/services/codex_client_version.g.dart
git commit -m "chore(release): prepare ${new_version}"

# Branch protection requires CI and a merged PR before release tagging.
echo "Version prepared: ${new_version}. Push this branch and merge its PR."
echo "After verifying merged main, create and push the exact v${major}.${minor}.${patch} tag."
