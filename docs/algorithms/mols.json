{
  "guid": "mols",
  "name": "More Like Space",
  "short_description": "Modulation Effect",
  "description": "This algorithm is a modulation effect of the chorus/flange/stereo-widening sort. It originates in the VST version of the Minky Starshine instrument, which is also present as a disting NT algorithm (above). The signal is fed into a number of delays in parallel. The 'Voices' parameter sets the number of delays - a higher number of voices tends to give a lusher sound. The delay time of the delays is each modulated by an LFO.",
  "categories": [
    "Modulation",
    "Chorus",
    "Flange",
    "Stereo"
  ],
  "use_cases": [
    "Chorus effect",
    "Flange effect",
    "Stereo widening"
  ],
