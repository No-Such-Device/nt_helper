{
  "guid": "ptch",
  "name": "Pitch reference",
  "short_description": "Generates a pitch reference tone",
  "description": "This algorithm simply generates a sine wave tone at a particular pitch or frequency. Note that if using a note to specify the pitch, it respects the global tuning setting.",
  "categories": [
    "Tone Generator",
    "Oscillator",
    "Utility"
  ],
  "parameters": [
    {
      "name": "Pitch mode",
      "min": 0,
      "max": 1,
      "default": 0,
      "description": "Sets the mode, either \"Pitch\", or \"Frequency\".",
      "enum_values": [
        "Pitch",
        "Frequency"
      ]
    },
    {
      "name": "Note",
      "min": 0,
      "max": 127,
      "default": 69,
      "description": "Sets the note pitch."
    },
    {
      "name": "Frequency",
      "min": 27.0,
      "max": 880.0,
      "default": 440.0,
      "description": "Sets the frequency.",
      "type": "string",
      "is_bus": true
    },
    {
      "name": "Output mode",
      "min": 0,
      "max": 1,
      "default": 0,
      "description": "The standard Add/Replace mode selector as described above.",
      "enum_values": [
        "Add",
        "Replace"
      ]
    },
    {
      "name": "Amplitude",
      "min": 0.0,
      "max": 10.0,
      "default": 10.0,
      "description": "The amplitude of the signal (before the gain is applied).",
      "type": "string",
      "is_bus": true
    },
    {
      "name": "Gain",
      "min": -40,
      "max": 6,
      "default": -40,
      "description": "The level of the output signal.",
      "type": "string",
      "is_bus": true
    }
  ],
  "output_ports": [
    {
      "name": "Output",
      "description": "The output bus."
    },
    {
      "name": "Output",
      "description": "The output bus."
    }
  ]
}