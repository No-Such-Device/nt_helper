#include <DriverKit/IOService.iig>
class InitialSdpDriver : public IOService {
public:
    virtual bool init() override;
    virtual void free() override;
    virtual kern_return_t Start(IOService *provider) override;
    virtual kern_return_t Stop(IOService *provider) override;
    virtual kern_return_t NewUserClient(uint32_t type, IOUserClient **client) override;
    kern_return_t Connect() LOCALONLY;
    void Disconnect() LOCALONLY;
    kern_return_t Query(uint64_t *hab, uint64_t *status) LOCALONLY;
};
